<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Log format:
        2026-05-04T10:23:11.421+0000  INFO   [req-id:a1b2c3f4]  c.t.habit.HabitService          : Habit created  user_id=... habit_id=...

        Fields:
          %d            — ISO 8601 timestamp with timezone
          %-5level      — log level, left-padded to 5 chars (INFO , WARN , ERROR, DEBUG)
          [req-id:%X]   — MDC request ID (populated by MdcRequestFilter; "none" if outside a request)
          %logger{40}   — logger name, abbreviated to 40 chars
          %msg          — log message
          %n            — newline
          %throwable    — full stack trace on the next lines (only when an exception is present)
    -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}  %-5level  [req-id:%X{requestId:-none}]  %-40.40logger{39}  :  %msg%n%throwable</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        File appender — writes all logs to /logs/tracker.log
        Rolls daily and when file exceeds 50MB. Keeps 30 days of history.
        Mount /logs as a Docker volume to persist logs outside the container.
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/logs/tracker.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>/logs/tracker.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}  %-5level  [req-id:%X{requestId:-none}]  %-40.40logger{39}  :  %msg%n%throwable</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Root logger — writes to both console and file -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
