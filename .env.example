# ============================================================
# stride — Environment Variables
# ============================================================
# Copy this file to .env and fill in values before running.
#   cp .env.example .env
#
# .env is in .gitignore — never commit it.
# This file (.env.example) IS committed — it documents what is needed.
# ============================================================


# ── Database ─────────────────────────────────────────────────
DB_NAME=tracker_db
DB_USER=tracker_user
DB_PASSWORD=changeme_replace_in_production


# ── JWT ──────────────────────────────────────────────────────
# Must be at least 64 characters for HS256 security.
# Generate one: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-string-minimum-64-characters-required
JWT_EXPIRY_HOURS=24


# ── Admin seed account ───────────────────────────────────────
# Used to create the initial admin user on first run (Step 5)
ADMIN_EMAIL=admin@tracker.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_replace_in_production


# ── Frontend ─────────────────────────────────────────────────
# URL the React frontend uses to reach the backend API
VITE_API_BASE_URL=http://localhost:8080


# ── Logging ──────────────────────────────────────────────────
# Standard mode: leave all as INFO / OFF
# Verbose mode:  set LOG_LEVEL_APP=DEBUG and LOG_LEVEL_SQL=DEBUG

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=OFF
LOG_LEVEL_SQL_BIND=OFF
LOG_LEVEL_FLYWAY=INFO


# ── Quick verbose toggle ─────────────────────────────────────
# To enable full verbose logging, change just these two:
#
#   LOG_LEVEL_APP=DEBUG
#   LOG_LEVEL_SQL=DEBUG
#
# To also see Spring Security filter chain decisions:
#   LOG_LEVEL_SECURITY=DEBUG
#
# No rebuild required — just restart the container:
#   docker compose restart backend
